<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Description>Shows every Penumbra mod against your own collection and any others you pin, with search and folder filters. Early build: it only reads from Penumbra. Bulk toggles, mod sets, undo and one-click Glamourer looks are planned.</Description>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Wardrobe14.Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Penumbra.Api" Version="5.19.2" />
    <PackageReference Include="Glamourer.Api" Version="2.8.2" />
  </ItemGroup>
  <PropertyGroup>
    <Author>PriestKos</Author>
    <Authors>PriestKos</Authors>
    <Name>Wardrobe14</Name>
    <Punchline>A cross-collection view of your Penumbra mods; bulk toggles and Glamourer looks to follow.</Punchline>
    <RepoUrl>https://github.com/priestkos/Wardrobe14</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/priestkos/Wardrobe14/main/images/icon.png</IconUrl>
    <Tags>penumbra;glamourer;mods;utility;ui</Tags>
  </PropertyGroup>
</Project>
